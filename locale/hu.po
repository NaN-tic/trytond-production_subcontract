#, python-format
msgctxt "model:ir.message,text:msg_same_production_location"
msgid ""
"The production \"%(production)s\" can not create internal shipment because "
"warehouse production and party production are the same: \"%(warehouse)s\"."
msgstr ""
"A(z) „%(production)s” gyártáshoz nem hozható létre belső szállítmány, mert a"
" raktári és a partneri gyártási hely megegyezik: „%(warehouse)s”."
